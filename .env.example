# Supabase project settings — Project Settings → API Keys in the dashboard.
#
# Supabase renamed its API keys in 2025. Both systems work; the env var names
# below are ours and do not change either way:
#
#   New name (preferred)          Legacy name        Env var here
#   ----------------------------  -----------------  --------------------------
#   Publishable key sb_publishable_…  anon / public   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Secret key      sb_secret_…       service_role    SUPABASE_SERVICE_ROLE_KEY
#
# Legacy keys live under the "Legacy API Keys" tab on the same settings page.

# Safe to expose to the browser. RLS enforces access control on these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasses Row Level Security entirely. Never expose to the
# client, never prefix with NEXT_PUBLIC_. Used only in src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the deployment. Used to build QR code targets and the
# redirect URLs in confirmation/password-reset emails. Falls back to the
# request host when unset, which is fine locally but should be set in
# production so emailed links point at the real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
