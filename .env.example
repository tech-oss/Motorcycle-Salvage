# Supabase project settings — Project Settings → API in the Supabase dashboard.

# Safe to expose to the browser. RLS enforces access control on these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasses Row Level Security. Never expose to the client,
# never prefix with NEXT_PUBLIC_. Used only in src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=
